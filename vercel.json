{
    "builds": [
      {
        "src": "new_new_index.html",
        "use": "@vercel/static"
      },
      {
        "src": "resources/**/*",
        "use": "@vercel/static"
      },
      {
        "src": "tools/*.json",
        "use": "@vercel/static"
      },
      {
        "src": "function.js",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/.*",
        "dest": "/new_new_index.html"
      }
    ]
  }
  