{
    "builds": [
      {
        "src": "new_new_index.html",
        "use": "@vercel/static"
      },
      {
        "src": "resources/**/*",
        "use": "@vercel/static"
      },
      {
        "src": "tools/*.json",
        "use": "@vercel/static"
      },
      {
        "src": "function.js",
        "use": "@vercel/static"
      }
    ],
    
    "routes": [
        {
          "src": "/resources/(.*)",
          "dest": "/resources/$1"
        },
        {
          "src": "/tools/(.*)",
          "dest": "/tools/$1"
        },
        {
          "src": "/function.js",
          "dest": "/function.js"
        },
        {
          "src": "/.*",
          "dest": "/new_new_index.html"
        }
      ]
  }
  